# ── Required ────────────────────────────────────────────────────────────────
# The server refuses to start without these two.
MONGO_URI=mongodb://localhost:27017/skillswap-dev
# 32+ random characters (required length in production). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# ── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Comma separated list of browser origins allowed to call the API / open sockets.
# Example production value: https://your-app.vercel.app,http://localhost:5173
CLIENT_URLS=http://localhost:5173

# ── Auth ────────────────────────────────────────────────────────────────────
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d
# true = users must click the emailed link before they can sign in (needs SMTP_URL in production)
REQUIRE_EMAIL_VERIFICATION=false

# ── Social sign-in (optional) ───────────────────────────────────────────────
# A provider's button only appears when BOTH its id and secret are set.
# Public URL of THIS API, used to build the redirect URI registered with each provider:
#   <API_PUBLIC_URL>/api/auth/oauth/google/callback   and   .../github/callback
# Defaults to http://localhost:<PORT> for local development.
# API_PUBLIC_URL=https://your-api.example.com
# Google: https://console.cloud.google.com/apis/credentials  (OAuth client ID, type "Web application")
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GitHub: https://github.com/settings/developers  (OAuth Apps > New OAuth App)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ── Email (optional) ────────────────────────────────────────────────────────
# Without SMTP_URL, emails are printed to the server console in development.
# SMTP_URL=smtps://user:password@smtp.example.com
# MAIL_FROM=SkillSwap <no-reply@example.com>

# ── Tuning (optional) ───────────────────────────────────────────────────────
# SWAP_COOLDOWN_HOURS=72
# PRESENCE_DEBOUNCE_MS=5000
# AUTH_RATE_LIMIT_MAX=10
# API_RATE_LIMIT_MAX=300

# ── Seeding (local only) ────────────────────────────────────────────────────
# SEED_PASSWORD=       # leave empty to generate a random one
# ALLOW_SEED=true      # only if you really want to seed a non-local database
